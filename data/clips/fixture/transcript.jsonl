{"segment_id": "fixture:0", "session_id": "fixture", "speaker_id": "moderator", "role": "moderator", "text": "What should voters know about the economy?", "t_start": 0.0, "t_end": 5.0, "stt_confidence": 0.98, "low_conf_words": []}
{"segment_id": "fixture:1", "session_id": "fixture", "speaker_id": "speaker_a", "role": "speaker", "text": "The unemployment rate is exactly zero percent.", "t_start": 6.0, "t_end": 11.0, "stt_confidence": 0.98, "low_conf_words": []}
{"segment_id": "fixture:2", "session_id": "fixture", "speaker_id": "speaker_b", "role": "speaker", "text": "A rate falling from six percent to four percent falls by two percentage points.", "t_start": 12.0, "t_end": 17.0, "stt_confidence": 0.98, "low_conf_words": []}
{"segment_id": "fixture:3", "session_id": "fixture", "speaker_id": "speaker_a", "role": "speaker", "text": "My opponent wears expensive shoes, so their budget cannot work.", "t_start": 18.0, "t_end": 23.0, "stt_confidence": 0.98, "low_conf_words": []}
{"segment_id": "fixture:4", "session_id": "fixture", "speaker_id": "moderator", "role": "moderator", "text": "How would you change health care?", "t_start": 24.0, "t_end": 29.0, "stt_confidence": 0.98, "low_conf_words": []}
{"segment_id": "fixture:5", "session_id": "fixture", "speaker_id": "speaker_b", "role": "speaker", "text": "We can either close every hospital or accept my plan.", "t_start": 30.0, "t_end": 35.0, "stt_confidence": 0.98, "low_conf_words": []}
{"segment_id": "fixture:6", "session_id": "fixture", "speaker_id": "speaker_a", "role": "speaker", "text": "My proposal would expand access to preventive care.", "t_start": 36.0, "t_end": 41.0, "stt_confidence": 0.98, "low_conf_words": []}
{"segment_id": "fixture:7", "session_id": "fixture", "speaker_id": "speaker_b", "role": "speaker", "text": "One neighbor waited for surgery, so every hospital is failing.", "t_start": 42.0, "t_end": 47.0, "stt_confidence": 0.98, "low_conf_words": []}
{"segment_id": "fixture:8", "session_id": "fixture", "speaker_id": "moderator", "role": "moderator", "text": "What evidence supports those numbers?", "t_start": 48.0, "t_end": 53.0, "stt_confidence": 0.98, "low_conf_words": []}
{"segment_id": "fixture:9", "session_id": "fixture", "speaker_id": "speaker_a", "role": "speaker", "text": "The Earth has two moons.", "t_start": 54.0, "t_end": 59.0, "stt_confidence": 0.98, "low_conf_words": []}
{"segment_id": "fixture:10", "session_id": "fixture", "speaker_id": "speaker_b", "role": "speaker", "text": "Earth has one natural moon.", "t_start": 60.0, "t_end": 65.0, "stt_confidence": 0.98, "low_conf_words": []}
{"segment_id": "fixture:11", "session_id": "fixture", "speaker_id": "speaker_a", "role": "speaker", "text": "If we build one bus lane, soon nobody will be allowed to drive.", "t_start": 66.0, "t_end": 71.0, "stt_confidence": 0.98, "low_conf_words": []}
{"segment_id": "fixture:12", "session_id": "fixture", "speaker_id": "moderator", "role": "moderator", "text": "Please explain your energy policy.", "t_start": 72.0, "t_end": 77.0, "stt_confidence": 0.98, "low_conf_words": []}
{"segment_id": "fixture:13", "session_id": "fixture", "speaker_id": "speaker_b", "role": "speaker", "text": "Solar panels generate electricity from sunlight.", "t_start": 78.0, "t_end": 83.0, "stt_confidence": 0.98, "low_conf_words": []}
{"segment_id": "fixture:14", "session_id": "fixture", "speaker_id": "speaker_a", "role": "speaker", "text": "You asked about electricity, but what about your campaign donations?", "t_start": 84.0, "t_end": 89.0, "stt_confidence": 0.98, "low_conf_words": []}
{"segment_id": "fixture:15", "session_id": "fixture", "speaker_id": "speaker_b", "role": "speaker", "text": "My opponent says to ban all vehicles, although they proposed one bus lane.", "t_start": 90.0, "t_end": 95.0, "stt_confidence": 0.98, "low_conf_words": []}
{"segment_id": "fixture:16", "session_id": "fixture", "speaker_id": "moderator", "role": "moderator", "text": "Do you support the position you took last year?", "t_start": 96.0, "t_end": 101.0, "stt_confidence": 0.98, "low_conf_words": []}
{"segment_id": "fixture:17", "session_id": "fixture", "speaker_id": "speaker_a", "role": "speaker", "text": "Last year I supported the measure; today I oppose it.", "t_start": 102.0, "t_end": 107.0, "stt_confidence": 0.98, "low_conf_words": []}
{"segment_id": "fixture:18", "session_id": "fixture", "speaker_id": "speaker_b", "role": "speaker", "text": "The policy preceded the storm, so it caused the storm.", "t_start": 108.0, "t_end": 113.0, "stt_confidence": 0.98, "low_conf_words": []}
{"segment_id": "fixture:19", "session_id": "fixture", "speaker_id": "moderator", "role": "moderator", "text": "Thank you both for participating.", "t_start": 114.0, "t_end": 119.0, "stt_confidence": 0.98, "low_conf_words": []}
