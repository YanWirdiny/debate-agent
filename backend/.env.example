DEEPGRAM_API_KEY=
GROQ_API_KEY=
GROQ_API_KEY_2=               # optional: used when a call on GROQ_API_KEY fails
GEMINI_API_KEY=
# Free-tier Gemini key, used once GEMINI_BUDGET_USD is spent on GEMINI_API_KEY (or on a 429).
GEMINI_API_KEY_2=
GEMINI_BUDGET_USD=7
# Paid-tier prices (USD) used for the estimate; thinking tokens count as output.
GEMINI_PRICE_IN_PER_M=0.75
GEMINI_PRICE_OUT_PER_M=3.75
GEMINI_PRICE_GROUNDED_CALL=0.014
GOOGLE_FACTCHECK_KEY=
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=debate_agent
LLM_MODEL_FAST=
LLM_MODEL_GEMINI=
LLM_MODEL_GEMINI_FALLBACK=
LLM_PROVIDER=groq
REPLAY_TRANSCRIPT=0
REPLAY_EVENTS=
AUDIENCE_MIN_CONF=0.80
INTEL=fake

# Analysis cache (data/cache/llm_cache.sqlite): same video + same transcript = no new tokens. 0 = off.
LLM_CACHE=1
